# =============================================================
# Generation provider — OpenAI-compatible.
# =============================================================
LLM_PROVIDER=cerebras
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=csk-REPLACE_ME
LLM_MODEL=llama3.1-8b

# =============================================================
# Embedding — required for HYBRID (BM25 + dense) on Vercel.
# Must match the model used when you ran: npm run build-index
# =============================================================

# --- Local development (Ollama) ---
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text

# --- Production (OpenAI — same dims as your built .embeddings.json if you indexed with OpenAI) ---
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-REPLACE_ME
# EMBED_MODEL=text-embedding-3-small

# Optional: embeddings per HTTP request when not using Ollama (default 48)
# EMBED_BATCH_SIZE=64

# =============================================================
# Retrieval / mode tuning.
# =============================================================
TOP_K=3
ANSWER_AT=0.65
CLARIFY_AT=0.40
MIN_MARGIN=0.05
SHORT_QUERY_WORDS=5
MAX_CONTEXT_CHARS=6000
