# =============================================================
# Generation provider — OpenAI-compatible.
# =============================================================
# Cerebras (cloud, fast):
#   LLM_BASE_URL=https://api.cerebras.ai/v1
#   LLM_API_KEY=csk-...
#   LLM_MODEL=llama-4-scout-17b-16e-instruct
#
# Ollama (local):
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=gemma4:e4b
LLM_PROVIDER=cerebras
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=csk-REPLACE_ME
LLM_MODEL=llama-4-scout-17b-16e-instruct

# =============================================================
# Embedding provider — OPTIONAL.
# Leave EMBED_BASE_URL unset for BM25-only retrieval (works fine
# on small corpora and avoids a second provider). To enable
# hybrid retrieval, point at any OpenAI-compatible /v1/embeddings
# endpoint. The model must match the one used in build-index.
# =============================================================
# EMBED_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=nomic-embed-text

# =============================================================
# Retrieval / mode tuning.
# =============================================================
TOP_K=3

# Mode thresholds against the top retrieval score (cosine when
# dense is on, normalised BM25 otherwise):
#   >= ANSWER_AT  -> answer (cited reply)
#   >= CLARIFY_AT -> clarify (asks back, lists candidates)
#   below CLARIFY_AT -> guide (canned "tell me more")
ANSWER_AT=0.65
CLARIFY_AT=0.40

# When the gap between top-1 and top-2 is smaller than MIN_MARGIN
# AND the user's query has fewer than SHORT_QUERY_WORDS words,
# route to clarify (catches "I need a licence" without breaking
# "How do I pay an overdue fine").
MIN_MARGIN=0.05
SHORT_QUERY_WORDS=5

MAX_CONTEXT_CHARS=6000
