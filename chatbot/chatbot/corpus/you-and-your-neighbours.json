  "faqs": [
    {
      "q": "Where can I get help resolving disputes with my neighbours?",
      "a": "You can find general dispute resolution information at the Legal Aid NSW website, or for specific issues, you can use the provided links.",
      "link": "https://www.legalaid.nsw.gov.au/my-problem-is-about/my-neighbour"
    },
    {
      "q": "What should I do about disputes involving fences or boundaries?",
      "a": "For information on fences, boundaries, and retaining walls, you can visit the Legal Aid NSW website.",
      "link": "https://www.legalaid.nsw.gov.au/my-problem-is-about/my-neighbour/fences"
    },
    {
      "q": "How do I resolve disputes about trees and hedges?",
      "a": "You can access resources for resolving tree and hedge disputes through Legal Aid NSW or the Land and Environment Court of NSW.",
      "link": "https://www.legalaid.nsw.gov.au/my-problem-is-about/my-neighbour/trees"
    },
    {
      "q": "What if I have a complaint about noise from a neighbour?",
      "a": "You can report noise pollution to the relevant authorities.",
      "link": "https://www.service.nsw.gov.au/referral/report-noise-pollution"
    }
  ],
