  "faqs": [
    {
      "q": "Who can I contact if I have trouble accessing Service NSW information or services?",
      "a": "You can contact Service NSW directly if you are having trouble accessing any information or service.",
      "link": null
    },
    {
      "q": "How does Service NSW ensure its website is accessible?",
      "a": "The website is designed to be responsive, uses correctly structured semantic HTML, and includes WAI-ARIA roles for screen readers. It also ensures search and navigation options are keyboard accessible.",
      "link": null
    },
    {
      "q": "What types of accessibility testing do you carry out?",
      "a": "User-testing is carried out with a wide range of people and accessibility needs, including cognitive, mobile, auditory, and visual needs. Testing also occurs on assistive devices and software like screen readers and magnifiers.",
      "link": null
    }
  ],
