  "faqs": [
    {
      "q": "What is the right to access government information?",
      "a": "The Government Information (Public Access) Act 2009 (NSW) (GIPA Act) gives citizens an enforceable right to access government information unless there is an overriding public interest against disclosure.",
      "link": null
    },
    {
      "q": "How can I contact the Information Access Team?",
      "a": "You can contact the Information Access Team via phone at 02 9219 3700 (Monday to Friday 9am to 5pm, excluding public holidays), email at gipa@customerservice.nsw.gov.au, or post to Service NSW GIPA Team, McKell Building, 2-24 Rawson Place, Sydney NSW 2000.",
      "link": null
    },
    {
      "q": "What types of information are held by Service NSW?",
      "a": "Service NSW holds various records, including financial records, administration records, customer records, and personnel records.",
      "link": null
    }
