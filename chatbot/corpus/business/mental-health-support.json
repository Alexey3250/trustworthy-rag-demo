  "faqs": [
    {
      "q": "Where can I find resources for improving mental health at work?",
      "a": "You can find resources through guides like 'Small Business Guides: Mentally Healthy Workplaces' and programs such as SafeWork NSW’s mental health at work program.",
      "link": "https://www.nsw.gov.au/mental-health-at-work"
    },
    {
      "q": "What support is available for small business owners?",
      "a": "Support is available through programs like NewAccess for Small Business Owners, Beyond Blue's work and mental health online portal, and the Rural Financial Counselling Service.",
      "link": null
    },
    {
      "q": "What free mental health support is available?",
      "a": "Resources include free mental health training and up to 4 hours of one-on-one coaching.",
      "link": null
