  "faqs": [
    {
      "q": "How do I redeem a voucher from a customer?",
      "a": "Use the Service NSW Business Bureau app (on a phone or tablet) to scan a QR voucher code or manually enter the voucher code.",
      "link": "https://www.service.nsw.gov.au/service-nsw-business-bureau-app"
    },
    {
      "q": "What happens to unused voucher amounts?",
      "a": "Neither the customer nor the business will receive the unused amount.",
      "link": null
    },
    {
      "q": "How can I view my transaction history?",
      "a": "Log in to the Service NSW Business Bureau app using your MyServiceNSW Account, select 'Program management' and the program, then select ‘Program transactions’ to view history.",
      "link": null
    },
    {
      "q": "Who can use the voucher?",
      "a": "The voucher must only be used by the person registered to receive it and cannot be transferred to anyone else.",
      "link": null
    }
  ],
