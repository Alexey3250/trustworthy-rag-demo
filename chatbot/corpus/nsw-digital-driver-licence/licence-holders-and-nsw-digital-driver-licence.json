    {
      "q": "Is the NSW Digital Driver Licence free to use?",
      "a": "The NSW Digital Driver Licence is optional and available at no additional cost.",
      "link": null
    },
    {
      "q": "How does the digital licence update?",
      "a": "Updates are in real time, meaning you do not have to wait for a new plastic card to be posted when your licence is renewed or if you change your details.",
      "link": null
    },
    {
      "q": "How can I add my digital licence?",
      "a": "Download the Service NSW app, log in with your MyServiceNSW Account details, select 'Wallet', tap 'Add', select 'Driver Licence', and follow the prompts.",
      "link": null
    }
