  "faqs": [
    {
      "q": "What is the Independent Pricing and Regulatory Tribunal (IPART)?",
      "a": "IPART is an independent body that regulates pricing and services across various industries, including water, energy, and transport.",
      "link": null
    },
    {
      "q": "What industries does IPART regulate?",
      "a": "IPART regulates various industries, including water services, energy services, transport services, local government services, and other industries.",
      "link": null
    },
    {
      "q": "How can I provide feedback or comment on a review?",
      "a": "You can find information on how to provide feedback or comment on reviews through the 'Reviews for public comment' section.",
      "link": "https://www.ipart.nsw.gov.au/Home/Reviews"
    }
