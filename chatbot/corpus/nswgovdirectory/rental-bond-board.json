    {
      "q": "What is the purpose of the Rental Bond Board?",
      "a": "The Rental Bond Board is responsible for managing the bond money paid by tenants and landlords for residential rental properties in NSW.",
      "link": null
    },
    {
      "q": "Who manages the bond money?",
      "a": "The bond money is managed by the Rental Bond Board.",
      "link": null
    },
    {
      "q": "What happens to the bond when I move out?",
      "a": "The bond is typically returned to the tenant after the tenancy ends, provided there are no damages or outstanding rent.",
      "link": null
