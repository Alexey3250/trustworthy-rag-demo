  "faqs": [
    {
      "q": "What information is collected for my MyServiceNSW Account?",
      "a": "Depending on the service, information collected may include your email address, password, mobile number, full name, residential address, and whether you identify as being of Aboriginal and/or Torres Strait Islander descent.",
      "link": null
    },
    {
      "q": "Why does Service NSW collect my personal information?",
      "a": "Information is collected to help you pre-complete online forms, verify your identity, enable transactions, access services, and improve security on your account.",
      "link": null
    },
    {
      "q": "How is my personal information used for fraud control?",
      "a": "Information may be used for fraud control purposes, including undertaking investigations to determine if the account was used fraudulently or if the information provided was misleading.",
      "link": null
    }
