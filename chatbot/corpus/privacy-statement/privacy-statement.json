  "faqs": [
    {
      "q": "What types of personal information does Service NSW collect?",
      "a": "Service NSW collects information to assist with transactions, provide transaction details, and gather information from online interactions or visits to Service Centres.",
      "link": null
    },
    {
      "q": "How does Service NSW use personal information?",
      "a": "Information is used to process customer transactions, update and maintain customer records, and support business operations, including maintaining records of calls and chats.",
      "link": null
    },
    {
      "q": "Do you collect data from partner or client agencies?",
      "a": "Yes, Service NSW collects information from partner agencies (like Transport for NSW) to process transactions, and from client agencies to update and maintain primary customer records.",
      "link": null
    },
    {
      "q": "What should I do if I have privacy concerns or complaints?",
      "a": "The page provides sections for privacy enquiries and complaints, detailing how citizens can raise concerns.",
      "link": null
    }
