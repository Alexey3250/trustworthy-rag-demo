  "faqs": [
    {
      "q": "What services are available at the Batemans Bay Service Centre?",
      "a": "Services include birth, death, or marriage certificates, boating licences and vessel registrations, business licensing, change of address for Transport for NSW, contractor licence applications, driver and rider licences, and driver testing.",
      "link": null
    },
    {
      "q": "How can I pay for my services?",
      "a": "You can pay using cash, EFTPOS, credit, or debit card.",
      "link": null
    },
    {
      "q": "Are there accessibility facilities available?",
      "a": "The centre offers Auslan video remote interpreting, a hearing loop, Quiet Hour, remote live captioning, wheelchair access, street level access to the entrance, and on-site parking in shopping centre bays.",
      "link": null
    }
  ],
