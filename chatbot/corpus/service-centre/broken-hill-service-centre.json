  "faqs": [
    {
      "q": "What services are available at the Broken Hill Service Centre?",
      "a": "Services include birth, death, or marriage certificates, boating licences and vessel registrations, business licensing, change of address for Transport for NSW, contractor licence applications, driver and rider licences, and driver testing.",
      "link": null
    },
    {
      "q": "How can I pay for my services?",
      "a": "You can pay using cash, EFTPOS, or credit or debit card.",
      "link": null
    },
    {
      "q": "Is the service centre accessible?",
      "a": "The centre offers wheelchair access, on-site parking, and has a dedicated mobility car park. It also provides Auslan video remote interpreting, hearing loop, and remote live captioning.",
      "link": null
    },
    {
      "q": "Are there other nearby Service NSW locations?",
      "a": "Nearby locations include the Menindee Police Station, Wilcannia Agency, and the Wentworth Service Centre.",
      "link": null
    }
  ],
