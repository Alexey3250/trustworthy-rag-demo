  "faqs": [
    {
      "q": "What services are available at the Lismore Service Centre?",
      "a": "Services include obtaining birth, death, or marriage certificates, boating licences and vessel registrations, changing your address for Transport for NSW, and applying for contractor licences. You can also get driver and rider licences, take a Driver Knowledge Test (DKT), and have eyesight tests.",
      "link": null
    },
    {
      "q": "How can I pay for my services?",
      "a": "You can pay using cash, EFTPOS, or credit or debit card.",
      "link": null
    },
    {
      "q": "Is the Lismore Service Centre accessible?",
      "a": "The centre offers wheelchair access, entry at street level, on-site parking, and on-street parking. It also provides Auslan video remote interpreting, a hearing loop, and remote live captioning.",
      "link": null
    },
    {
      "q": "Where can I find other nearby Service Centres?",
      "a": "Other nearby locations include the Casino Service Centre and the Ballina Service Centre.",
      "link": null
    }
  ],
