  "faqs": [
    {
      "q": "What services are available at the North Rocks Service Centre?",
      "a": "Services available include birth, death or marriage certificates, boating licences and vessel registrations, change of address for Transport for NSW, contractor licence applications, driver and rider licences, and driver testing.",
      "link": null
    },
    {
      "q": "How can I plan my visit to the service centre?",
      "a": "You can plan ahead by paying with EFTPOS, credit, or debit card. The centre also offers accessibility facilities such as Auslan video remote interpreting, a hearing loop, a quiet hour, and wheelchair access.",
      "link": null
    },
    {
      "q": "Where are the nearest Service Centres to North Rocks?",
      "a": "The nearest locations include the Parramatta Service Centre, Castle Hill Service Centre, and Silverwater Service Centre.",
      "link": null
    }
  ],
