  "faqs": [
    {
      "q": "How do I start or update my vessel registration?",
      "a": "You can apply for a new vessel registration, reserve a personalized number, or renew/restore an existing registration. You can also change details or transfer ownership.",
      "link": null
    },
    {
      "q": "What do I do if I sell or dispose of my boat?",
      "a": "You must submit a notice of disposal for the vessel to properly transfer or cancel the registration.",
      "link": null
    },
    {
      "q": "How can I check the status of a boat or vessel?",
      "a": "You can check a vessel registration directly, or check the Personal Property Securities Register (PPSR) before buying a boat.",
      "link": null
    },
    {
      "q": "What if I need to change the identification details of my vessel?",
      "a": "You can change a vessel's details, change to a personalized registration number, or update the HIN certificate details.",
      "link": null
    }
