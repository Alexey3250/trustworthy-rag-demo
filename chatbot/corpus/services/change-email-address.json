  "faqs": [
    {
      "q": "How do I change my email address for my MyServiceNSW Account?",
      "a": "Log in to your MyServiceNSW Account, go to 'Manage account', then 'Personal details'. Select 'Update' next to 'Email', enter your new email, and select 'Continue'.",
      "link": "https://account.service.nsw.gov.au/manage/personal-details"
    },
    {
      "q": "How do I change my email address using the Service NSW app?",
      "a": "Log in to the Service NSW app, select the profile or 'person' icon, choose 'Personal details', select 'Email', enter your new email, and select 'Continue'.",
      "link": "https://www.service.nsw.gov.au/campaign/service-nsw-mobile-app"
    },
    {
      "q": "What information changes when I update my email address?",
      "a": "The email address you use to log in to your MyServiceNSW Account, and your Driver Licence and Vehicle registration details.",
      "link": null
    }
