  "faqs": [
    {
      "q": "Where can I find services with special accessibility features?",
      "a": "You can find a service centre with Quiet Hour, access Visual Stories for step-by-step guides, or use the Hidden Disabilities Sunflower program.",
      "link": "https://www.service.nsw.gov.au/about-us/our-services/quiet-hour"
    },
    {
      "q": "What support is available for transport needs due to a disability?",
      "a": "Services include the Taxi Transport Subsidy Scheme, Isolated Patients Travel and Accommodation Assistance Scheme (IPTAAS), and various travel passes for different groups.",
      "link": null
    },
    {
      "q": "What resources are available for carers and guardians?",
      "a": "Resources include guides for carers, information on Power of Attorney, and the Companion Card.",
      "link": null
    },
    {
      "q": "Which government agencies can help with disability support?",
      "a": "You can access services through agencies like the National Disability Insurance Scheme (NDIS), Disability Council NSW, and Ageing and Disability Commission, NSW.",
      "link": null
    }
  ],
