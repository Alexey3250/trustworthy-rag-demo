  "faqs": [
    {
      "q": "What types of energy rebates are available?",
      "a": "Rebates are available for Family Energy (retail and on supply customers), Seniors Energy, Gas (retail and on-supply/bottled gas customers), and Low Income Household (retail and on-supply customers).",
      "link": null
    },
    {
      "q": "Where can I find help with energy bills?",
      "a": "You can find assistance for households and small businesses regarding National Energy Bill Relief payments, and also get help with specific water bills from Sydney Water and Hunter Water.",
      "link": null
    },
    {
      "q": "What assistance is available if I have trouble paying my energy bills?",
      "a": "Assistance programs include Energy Accounts Payment Assistance (EAPA) and the No Interest Loans Scheme (NILS).",
      "link": null
    },
    {
      "q": "How can I save energy and money?",
      "a": "You can compare energy plans using Energy Made Easy, find energy-efficient appliances, and learn about household energy saving upgrades.",
      "link": null
    }
