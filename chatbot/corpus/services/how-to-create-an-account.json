  "faqs": [
    {
      "q": "What can I do with a MyServiceNSW Account?",
      "a": "You can use your account to check and renew licences and registrations, claim vouchers and rebates, switch to digital notifications, and find details about your services without calling or waiting in line.",
      "link": null
    },
    {
      "q": "How do I start creating my MyServiceNSW Account?",
      "a": "Go to the Create an account page and follow the prompts.",
      "link": "https://account.service.nsw.gov.au/createaccount"
    },
    {
      "q": "What should I do after creating my account?",
      "a": "You should add services you want to manage online, add personal details like your mobile number and address, set your notification preferences, and keep your account details private.",
      "link": null
    }
