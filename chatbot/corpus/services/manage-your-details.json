  "faqs": [
    {
      "q": "What are the benefits of having a MyServiceNSW Account?",
      "a": "A MyServiceNSW Account connects you online with NSW Government services, allowing you to save personal details, receive notifications to correct contact options, and help keep your account secure.",
      "link": null
    },
    {
      "q": "How do I update my personal details online?",
      "a": "You can log in to your MyServiceNSW Account, go to 'Manage account', then 'Personal details', and select the details you wish to add or update.",
      "link": "https://account.service.nsw.gov.au/manage/personal-details"
    },
    {
      "q": "Can I update my details using the Service NSW app?",
      "a": "Yes, you can open the Service NSW app, select the profile or 'person' icon, choose 'Personal details', and then select the details you want to update.",
      "link": "https://www.service.nsw.gov.au/campaign/service-nsw-mobile-app"
    }
  ],
