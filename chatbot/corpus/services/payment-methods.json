  "faqs": [
    {
      "q": "What payment methods are accepted?",
      "a": "You can pay using credit or debit cards (Mastercard, Visa, American Express, or UnionPay), PayPal, or by using BPAY for vehicle registration renewal.",
      "link": null
    },
    {
      "q": "Where can I pay fees using cash?",
      "a": "Cash is not accepted at Mobile Service Centres, Eastgardens Service Centre, Edmondson Park Service Centre, Engadine Service Centre, Glenmore Park Service Centre, Macquarie Fields Driver Testing Centre, Merrylands Service Centre, and North Rocks Service Centre.",
      "link": null
    },
    {
      "q": "How do I pay for vehicle registration renewal?",
      "a": "You can pay for vehicle registration renewal by choosing BPAY as your payment type, which will generate a BPAY Biller Code and Reference Number.",
      "link": null
    },
    {
      "q": "What fees can I pay on this page?",
      "a": "You can pay for land tax and stamp duty, motor vehicle stamp duty, stamp duty on the sale of land or businesses in NSW, toll notices, and annual liquor licence fees.",
      "link": null
    }
  ],
