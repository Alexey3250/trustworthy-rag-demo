    {
      "q": "Do children travel free on public transport in NSW?",
      "a": "Children aged 3 years and under travel free on public transport in NSW.",
      "link": null
    },
    {
      "q": "What concessions are available for students?",
      "a": "Children aged 4–15 years can use the child/youth Opal card for concession fares, and full-time students aged 16 years and older can pay concession fares with an eligible student ID or a Transport Concession Entitlement Card.",
      "link": null
    },
    {
      "q": "Who is eligible for adult concessions?",
      "a": "Adult concessions are available for tertiary and TAFE students, apprentices and trainees, pensioners and seniors, Centrelink customers, asylum seekers, people with vision impairment, and Veterans.",
      "link": null
    }
