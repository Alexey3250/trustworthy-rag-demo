  "faqs": [
    {
      "q": "What services are available for seniors?",
      "a": "Seniors can apply for the NSW Seniors Card, NSW Photo Card, Seniors Energy Rebate, NSW Gas Rebate, and other concessions like the gold senior/pensioner Opal card.",
      "link": "https://www.service.nsw.gov.au/services/nsw-seniors-card-program"
    },
    {
      "q": "What support is available for carers?",
      "a": "Carers can find information, apply for vehicle registration refunds, or manage vehicle registrations for a registered operator.",
      "link": "https://www.service.nsw.gov.au/guide/carers"
    },
    {
      "q": "What concessions are available for pensioners?",
      "a": "Pensioners can access concessions for travel, vehicle registration, driving licenses, and council rates, and can also claim water rebates.",
      "link": "https://www.service.nsw.gov.au/referral/use-your-concession-card-to-access-pensioner-travel-vouchers"
    }
  ],
