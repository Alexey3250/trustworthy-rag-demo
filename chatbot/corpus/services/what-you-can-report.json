    {
      "q": "How can I report a crime or scam?",
      "a": "You can report a crime, scam, or misdemeanour using the dedicated reporting service.",
      "link": "https://www.service.nsw.gov.au/services/reporting-crimes-and-misdemeanours"
    },
    {
      "q": "What if I find a problem with a vehicle or road?",
      "a": "You can report issues such as abandoned vehicles, potholes, unsafe driving, or littering from a vehicle.",
      "link": null
    },
    {
      "q": "Where can I report issues with goods or services?",
      "a": "You can report food safety complaints, unsafe products, or issues with goods and services.",
      "link": null
    },
    {
      "q": "How do I report issues related to smoking or vaping?",
      "a": "You can report cigarette butt tossing, smoking in smoke-free areas, or retailers breaking tobacco laws.",
      "link": null
    }
