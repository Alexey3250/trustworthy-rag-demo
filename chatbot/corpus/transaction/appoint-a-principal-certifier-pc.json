  "faqs": [
    {
      "q": "Who can be appointed as a principal certifier?",
      "a": "A principal certifier can be a registered building surveyor, your local council, or a registered body corporate (certification company).",
      "link": null
    },
    {
      "q": "What does a principal certifier do?",
      "a": "They oversee the construction phase of the development and complete mandatory building inspections, known as critical stage inspections, to ensure that building standards are met.",
      "link": null
    },
    {
      "q": "What checks should I complete before appointing a certifier?",
      "a": "You should go to the building certifiers public register, check the disciplinary register for actions taken against the certifier, carefully read the contract, and read the accompanying document.",
      "link": null
    }
  ],
