  "faqs": [
    {
      "q": "What should I do if I have been scammed?",
      "a": "Immediately stop all contact with the scammer. Report the scam as soon as possible, contact your bank or financial institution to cancel any breached cards or accounts, and write down all details about the scammer (phone number, email, website address, or car registration plate number). Also, inform your friends, family, and colleagues about your experience.",
      "link": null
    },
    {
      "q": "What are some examples of scams?",
      "a": "Scams can include buying or selling items via fake websites or online classifieds, dating and romance scams, fake charities, fake investment opportunities, job scams, unexpected money (like inheritance scams), unexpected refunds, hacking, email spam, phishing, and cyberbullying.",
      "link": null
    },
    {
      "q": "How do I report a scam?",
      "a": "You can report scams using the dedicated link: https://www.scamwatch.gov.au/report-a-scam.",
      "link": "https://www.scamwatch.gov.au/report-a-scam"
    },
    {
      "q": "What is identity theft?",
      "a": "Identity theft occurs when someone steals your personal or private information to commit fraud.",
      "link": null
    }
