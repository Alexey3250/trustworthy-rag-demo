  "faqs": [
    {
      "q": "Who can apply for EAPA?",
      "a": "EAPA helps people who are struggling to pay their energy bills. You must be a retail customer with an open energy account and have money owing on your bill.",
      "link": null
    },
    {
      "q": "How do I apply for EAPA?",
      "a": "You can apply for EAPA online using the provided link.",
      "link": "https://www.service.nsw.gov.au/transaction/energy-accounts-payment-assistance-eapa-scheme"
    },
    {
      "q": "What if I am a business owner?",
      "a": "Commercial or business customers may have different support options. You can check if your business is eligible for other help.",
      "link": "https://www.service.nsw.gov.au/business/business-support"
    },
    {
      "q": "Where can I find more help with energy bills?",
      "a": "You can talk to your energy retailer, or contact the Energy & Water Ombudsman NSW for assistance.",
      "link": null
    }
