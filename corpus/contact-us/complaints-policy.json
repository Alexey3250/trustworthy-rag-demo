  "faqs": [
    {
      "q": "What is the purpose of the complaints policy?",
      "a": "The policy aims to respond to complaints in a timely, customer-focused, and cost-effective manner, while also building trust in the NSW public service and providing information for service improvements.",
      "link": null
    },
    {
      "q": "Who must comply with this complaints policy?",
      "a": "All employees (including managers, supervisors, and senior executives, regardless of employment status), contractors, agency workers, employees seconded from other public sector agencies, and volunteers/students.",
      "link": null
    },
    {
      "q": "What are the guiding principles for handling complaints?",
      "a": "The principles are Accessibility (making it easy to submit a complaint), Systemise (proactively managing complaints), Collaborate (engaging involved parties), and Accountability (continuously learning and improving).",
      "link": null
    }
  ],
