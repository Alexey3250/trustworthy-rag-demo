    {
      "q": "How do I calculate the cost of a toll journey?",
      "a": "Use the Sydney Motorways calculator to work out the total cost for a journey. To check the cost for a specific toll road, see toll costs by road.",
      "link": null
    },
    {
      "q": "What options do I have for paying tolls?",
      "a": "You can use an E-Toll Account for regular toll road use on Sydney toll roads, an eMU Casual Pass for visiting NSW or up to 30 days of use, or an eRider account for frequent travel on the Sydney Harbour Bridge and Sydney Harbour Tunnel.",
      "link": null
    },
    {
      "q": "What should I do if I travel without a toll account or pass?",
      "a": "For the Sydney Harbour Bridge and Sydney Harbour Tunnel, visit E-Toll. For all other toll road notices, visit Linkt.",
      "link": null
    }
