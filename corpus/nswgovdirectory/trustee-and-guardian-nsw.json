  "faqs": [
    {
      "q": "What is the NSW Trustee and Guardian?",
      "a": "The NSW Trustee and Guardian is a service that provides assistance with managing property and making decisions for people who are unable to do so themselves.",
      "link": null
    },
    {
      "q": "How can I plan for my future?",
      "a": "You can make a will, make a Power of Attorney, or choose an Enduring Guardian to help plan for your future.",
      "link": null
