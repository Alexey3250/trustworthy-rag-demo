  "faqs": [
    {
      "q": "What services are available at the Auburn Service Centre?",
      "a": "Services include obtaining birth, death, or marriage certificates, boating licences and vessel registrations, business licensing, change of address for Transport for NSW, contractor licence applications, driver and rider licences, driver knowledge tests (DKT), and eyesight tests.",
      "link": null
    },
    {
      "q": "How can I pay for services at the centre?",
      "a": "You can pay using cash, EFTPOS, or credit or debit card.",
      "link": null
    },
    {
      "q": "What accessibility facilities are available?",
      "a": "The centre offers Auslan video remote interpreting, a hearing loop, Quiet Hour, remote live captioning, wheelchair access, entry at street level, on-site parking, and street parking.",
      "link": null
    },
    {
      "q": "Where can I find other nearby service locations?",
      "a": "Nearby locations include the Auburn Dealer Business Centre, Auburn Mobile Driver Testing, and the Silverwater Service Centre.",
      "link": null
    }
  ],
