  "faqs": [
    {
      "q": "What services are available at the Bankstown Service Centre?",
      "a": "Services available include birth, death, or marriage certificates, boating licences and vessel registrations, business licensing, change of address for Transport for NSW, contractor licence applications, driver and rider licences, and driver knowledge tests.",
      "link": null
    },
    {
      "q": "How can I pay for my services?",
      "a": "You can pay using cash, EFTPOS, credit, or debit card.",
      "link": null
    },
    {
      "q": "Are there accessibility facilities at the centre?",
      "a": "The centre offers Auslan video remote interpreting, a hearing loop, Quiet Hour, remote live captioning, wheelchair access, and is located within a shopping centre with on-site parking.",
      "link": null
    }
  ],
