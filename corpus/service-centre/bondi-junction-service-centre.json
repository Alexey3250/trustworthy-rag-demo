  "faqs": [
    {
      "q": "What services are available at the Bondi Junction Service Centre?",
      "a": "Services include obtaining birth, death, or marriage certificates, managing boating licences and vessel registrations, business licensing, and applying for various licences like driver and rider licences.",
      "link": null
    },
    {
      "q": "How can I pay for services at the centre?",
      "a": "You can pay using cash, EFTPOS, or credit or debit card.",
      "link": null
    },
    {
      "q": "Is the service centre accessible for people with disabilities?",
      "a": "The centre offers wheelchair access, entry at street level, and has facilities like Auslan video remote interpreting and a hearing loop.",
      "link": null
    }
  ],
