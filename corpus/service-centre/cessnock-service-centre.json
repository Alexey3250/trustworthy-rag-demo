  "faqs": [
    {
      "q": "What services are available at the Cessnock Service Centre?",
      "a": "Services include birth, death, or marriage certificates, boating licences and vessel registrations, business licensing, change of address for Transport for NSW, contractor licence applications, driver and rider licences, and driver testing.",
      "link": null
    },
    {
      "q": "How can I pay for services at the centre?",
      "a": "You can pay using cash, EFTPOS, or credit or debit card.",
      "link": null
    },
    {
      "q": "Are there accessibility facilities at the Cessnock Service Centre?",
      "a": "The centre offers hearing loop, quiet hour, wheelchair access, entry at street level, on-site parking, street parking, and two mobility car parks on-site, with on-site disability parking less than 25m to the entrance.",
      "link": null
    }
  ],
