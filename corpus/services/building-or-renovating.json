  "faqs": [
    {
      "q": "What do I need to do before I start building or renovating?",
      "a": "You may need to obtain various permits and approvals, such as an Owner-Builder Permit or a development application.",
      "link": "https://www.service.nsw.gov.au/services/owner-builder-permit"
    },
    {
      "q": "How do I manage building inspections and certificates?",
      "a": "You can apply for various certificates (like construction or occupation certificates) and manage plumbing and drainage inspections through MyInspections.",
      "link": "https://www.service.nsw.gov.au/transaction/apply-for-a-construction-certificate"
    },
    {
      "q": "What should I do if I have a home building complaint or claim?",
      "a": "You can lodge a home building complaint with the Building Commission NSW or use the Home Building Compensation (HBC) Check if you need to make a claim.",
      "link": "https://www.service.nsw.gov.au/transaction/lodge-a-home-building-complaint-with-the-building-commission-nsw"
    },
    {
      "q": "What are the rules for dealing with asbestos?",
      "a": "The page provides information on asbestos for property owners and renovators, including programs for loose-fill asbestos and finding disposal sites.",
      "link": "https://www.asbestos.nsw.gov.au/"
    }
