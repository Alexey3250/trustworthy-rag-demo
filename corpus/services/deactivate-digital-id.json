  "faqs": [
    {
      "q": "What happens if I deactivate my NSW Digital ID?",
      "a": "You will no longer be able to use it to verify your identity in a single step during NSW Government online transactions. You will need to use multiple documents to prove your identity.",
      "link": null
    },
    {
      "q": "Can I still use MyServiceNSW Account after deactivating my Digital ID?",
      "a": "Yes, you can continue to use your MyServiceNSW Account to access services like your NSW Digital Driver Licence or Photo Card.",
      "link": null
    }
