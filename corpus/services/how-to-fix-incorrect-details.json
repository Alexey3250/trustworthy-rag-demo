  "faqs": [
    {
      "q": "Why might my details in MyServiceNSW Account be incorrect?",
      "a": "Details may be incorrect if you have changed your personal information but not updated it in your account, if you previously added someone else's details, or if you are sharing your account.",
      "link": null
    },
    {
      "q": "How do I update my personal details?",
      "a": "Log in to your MyServiceNSW Account, go to 'Personal details', select the details you want to update, and save your changes.",
      "link": "https://account.service.nsw.gov.au/manage/personal-details"
    },
    {
      "q": "How can I refresh my licence details?",
      "a": "Open your Digital Driver Licence in the Service NSW app, select the menu button, choose 'Refresh licence details', and then press the 'Refresh licence details' button.",
      "link": null
    },
    {
      "q": "How do I remove or add services to my account?",
      "a": "Log in to your MyServiceNSW Account, go to 'Remove services' to remove services, and then go to 'Add services' to select and add services using your own details.",
      "link": null
    }
  ],
