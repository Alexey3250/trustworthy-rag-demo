  "faqs": [
    {
      "q": "Where can I find information about insurance coverage and claims after a disaster?",
      "a": "You can find fact sheets on insurance coverage and claims from the Financial Rights Legal Service, information on home insurance (storm, flood, and fire) from ASIC's Moneysmart, and guidance on damage to rented premises from the Tenants' Union.",
      "link": null
    },
    {
      "q": "What types of legal issues can the Disaster Response Legal Service help with?",
      "a": "The Disaster Response Legal Service covers insurance claims and disputes, employment, financial hardship (such as loans, mortgages, and credit cards), unpaid fines, housing and rental, coronial inquests, and Centrelink payments.",
      "link": null
    },
    {
      "q": "How can I get general legal assistance?",
      "a": "You can find ways to get legal help by calling 1300 888 529, finding a Legal Aid NSW advice service near you, learning about community legal centres, or going to the Aboriginal Legal Service.",
      "link": null
    }
  ],
