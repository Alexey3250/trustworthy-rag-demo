  "faqs": [
    {
      "q": "How can I get help with language barriers?",
      "a": "You can find help in your language, book an interpreter for spoken language, or apply for document translation services.",
      "link": "https://www.service.nsw.gov.au/about-us/our-services/help-in-your-language"
    },
    {
      "q": "What services are available for new arrivals?",
      "a": "You can access support and guidance for new arrivals, and book an appointment at a service centre.",
      "link": "https://www.service.nsw.gov.au/transaction/book-a-new-arrivals-appointment"
    },
    {
      "q": "How do I manage my identity documents?",
      "a": "You can verify your identity, register a change of name, or get information on Australian passports and visas.",
      "link": "https://www.service.nsw.gov.au/guide/australian-passports-and-visas"
    },
    {
      "q": "What educational support is available?",
      "a": "Support is available for international students, including enrolling in primary or secondary schools and TAFE NSW.",
      "link": "https://www.service.nsw.gov.au/guide/support-for-international-students"
    },
    {
      "q": "Do I need to worry about driving licenses?",
      "a": "You can apply for a learner driver licence, transfer an overseas driver licence, or apply for a NSW licence as a temporary overseas visitor.",
      "link": "https://www.service.nsw.gov.au/transaction/transfer-an-overseas-driver-licence"
    }
  ],
