  "faqs": [
    {
      "q": "How do I apply for a motor dealer licence?",
      "a": "You can apply for a motor dealer licence or a motor dealer wholesaler licence using the provided links.",
      "link": "https://www.service.nsw.gov.au/transaction/apply-for-a-motor-dealer-licence"
    },
    {
      "q": "What if I need to renew or replace my licence?",
      "a": "You can renew, replace, or restore your motor dealer licence through dedicated service links.",
      "link": "https://www.service.nsw.gov.au/transaction/renew-a-motor-dealer-licence"
    },
    {
      "q": "How can I check or change the details on my licence?",
      "a": "You can check your licence details or change details for your licence or premises using the available online services.",
      "link": "https://www.service.nsw.gov.au/transaction/check-a-motor-dealer-licence"
    },
    {
      "q": "Do I need to surrender my motor dealer licence?",
      "a": "If you no longer need the licence, you can surrender it using the dedicated service link.",
      "link": "https://www.service.nsw.gov.au/transaction/surrender-a-motor-dealer-licence"
