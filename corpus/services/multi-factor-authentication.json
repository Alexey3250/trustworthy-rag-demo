  "how_to_steps": [
    {
      "n": 1,
      "text": "Log in to your MyServiceNSW Account.",
      "link": "https://account.service.nsw.gov.au/"
    },
    {
      "n": 2,
      "text": "Go to 'Manage account'.",
      "link": null
    },
    {
      "n": 3,
      "text": "Go to 'Settings and security'.",
      "link": null
    },
    {
      "n": 4,
      "text": "Go to 'Multi-factor authentication'.",
      "link": "https://account.service.nsw.gov.au/manage/settings/multifactor"
    },
    {
      "n": 5,
      "text": "Follow the prompts to select an MFA method and set up:",
      "link": "https://www.microsoft.com/en-au/security/mobile-authenticator-app"
    },
    {
      "n": 6,
      "text": "Open and log in to the Service NSW app.",
      "link": "https://www.service.nsw.gov.au/campaign/service-nsw-mobile-app"
    },
    {
      "n": 7,
      "text": "Select the profile or 'person' icon.",
      "link": null
    },
    {
      "n": 8,
      "text": "Go to 'Security settings'.",
      "link": null
    },
    {
      "n": 9,
      "text": "Go to 'Multi-factor authentication' and select an MFA method to set up:",
      "link": "https://www.microsoft.com/en-au/security/mobile-authenticator-app"
    },
    {
      "n": 10,
      "text": "Log in using your Business Bureau app or Business Profile using your MyServiceNSW Account.",
      "link": "https://www.service.nsw.gov.au/service-nsw-business-bureau-app"
    },
    {
      "n": 11,
      "text": "Go to ‘Edit profile’.",
      "link": null
    },
    {
      "n": 12,
      "text": "Under the title ‘Security’, select ‘multi-factor authentication’.",
      "link": null
    },
    {
      "n": 13,
      "text": "Select an MFA method follow the prompts to set it up.",
      "link": null
    }
