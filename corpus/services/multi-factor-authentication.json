  "what_you_need": [
    "An existing MyServiceNSW Account or the ability to create one.",
    "An Australian mobile number.",
    "The Service NSW app (downloadable from the App Store or Google Play).",
    "A reputable authenticator app (such as Microsoft Authenticator or Google Authenticator) downloaded from the App Store or Google Play."
