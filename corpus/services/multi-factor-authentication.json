  "faqs": [
    {
      "q": "What is multi-factor authentication (MFA)?",
      "a": "MFA is a security measure that requires you to use multiple methods to verify your identity when logging in.",
      "link": null
    },
    {
      "q": "Are there different ways to set up MFA?",
      "a": "Yes, you can set up MFA using the Service NSW app or a reputable authenticator app, which are more secure than using text messages (SMS).",
      "link": null
    },
    {
      "q": "Where can I set up multi-factor authentication?",
      "a": "You can set up MFA through the MyServiceNSW Account settings by navigating to 'Multi-factor authentication'.",
      "link": "https://account.service.nsw.gov.au/manage/settings/multifactor"
    }
  ],
