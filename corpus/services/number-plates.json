  "faqs": [
    {
      "q": "How can I order different types of number plates?",
      "a": "You can order special number plates, auxiliary (bike rack) plates, or souvenir miniature numeral-only plates. You can also order plates as a dealer with an agreement.",
      "link": null
    },
    {
      "q": "What do I do if my number plates are lost, stolen, or destroyed?",
      "a": "You can report lost, stolen, or destroyed number plates using the dedicated service.",
      "link": "https://www.service.nsw.gov.au/transaction/report-lost-stolen-or-destroyed-number-plates"
    },
    {
      "q": "Can I temporarily store my number plates?",
      "a": "You can place your number plates on hold or in storage, and you can also renew the storage period or change the storage location.",
      "link": null
    },
    {
      "q": "How do I transfer or change my number plates?",
      "a": "You can transfer number plates or replace or change existing number plates.",
      "link": null
    }
