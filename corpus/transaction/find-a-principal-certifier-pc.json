  "faqs": [
    {
      "q": "What does a principal certifier (PC) do?",
      "a": "A principal certifier is a registered building surveyor, local council, or registered body corporate that carries out mandatory building inspections during construction and issues the development certificate when all requirements are met.",
      "link": null
    },
    {
      "q": "Who should appoint the certifier?",
      "a": "You choose who you appoint as a certifier. Your builder cannot appoint the certifier or influence your choice.",
      "link": null
    },
    {
      "q": "Where can I find a principal certifier?",
      "a": "You can search the Building Certifiers Public Register using the search tool, which allows advanced searching by location and class of registration.",
      "link": "https://applications.fairtrading.nsw.gov.au/bdcregister/"
    }
