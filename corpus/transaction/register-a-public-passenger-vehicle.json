  "who_can_apply": [],
  "what_you_need": [
    "Proof of identity",
    "Proof of registration entitlement",
    "Compulsory third party (CTP) insurance",
    "Vehicle Compliance Certificate from a licensed certifier (if the vehicle has been modified)",
    "Copy of the accredited operator's Certificate of Accreditation",
    "Letter from the accredited operator (if the vehicle is not registered in the accredited operator's name)",
    "Original AUVIS/HVAIS inspection report",
    "Valid Transaction Authorisation Letter from the Point to Point Transport Commissioner (for taxi plates)",
    "Completed 'Application for Registration' form"
